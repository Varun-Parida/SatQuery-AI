# Environment variables for SatQuery AI
# Copy this to .env.local and fill in the values

# API Configuration
# FastAPI backend root (routes: /health, /upload, /analyze, /result/{id}, /evidence/{file})
VITE_API_BASE_URL=http://127.0.0.1:8000
# false = real FastAPI backend, true = simulated mock service
VITE_USE_MOCK_API=false

# Map Configuration (optional)
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# Upload limits
VITE_MAX_FILE_SIZE_MB=50
VITE_SUPPORTED_FORMATS=png,jpg,jpeg,tiff,tif,geotiff
